# Risk R-03: CRLF inside Linux containers breaks shell entrypoints, Compose files and
# Prisma migration execution. Anything executed inside a container is forced to LF.
* text=auto

*.sh        text eol=lf
Dockerfile* text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
prisma/**   text eol=lf

# Never normalise binaries.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
