{
  "name": "@sunil/agents",
  "version": "0.1.0",
  "private": true,
  "description": "SKELETON — agent runtime: config loading/validation, envelope emission, heartbeats, in-loop budget/timeout enforcement. Owned by a wave-2 agent (§11).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.spec.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@sunil/core": "workspace:*",
    "@sunil/db": "workspace:*",
    "@sunil/llm": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
