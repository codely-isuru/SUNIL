{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sunil-api",
      "runtimeExecutable": "apps/api/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "sunil.main:create_app", "--factory", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "apps/api",
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "sunil-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "3000"],
      "cwd": "apps/web",
      "port": 3000,
      "url": "http://localhost:3000"
    }
  ]
}
