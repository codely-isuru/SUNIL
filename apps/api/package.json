{
  "name": "@sunil/api",
  "version": "0.1.0",
  "private": true,
  "description": "SKELETON — NestJS 11 on Fastify. Auth, RBAC, audit enforcement, secrets, all REST. Owned by wave-2 agents (§6, §7, §8, §13).",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json",
