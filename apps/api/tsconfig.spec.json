{
  "//": "Typechecks the test sources, which the build tsconfig deliberately excludes so vitest never lands in dist.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/db" },
    { "path": "../../packages/llm" },
    { "path": "../../packages/agents" }
  ],
  "include": ["src/**/*.ts"]
}
