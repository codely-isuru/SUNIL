{
  "name": "@sunil/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SKELETON — BullMQ processors for the `agents` and `system` queues. No HTTP surface. Owned by a wave-2 agent (§12).",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.spec.json",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js"
  },
  "dependencies": {
    "@sunil/agents": "workspace:*",
    "@sunil/core": "workspace:*",
    "@sunil/db": "workspace:*",
    "@sunil/llm": "workspace:*",
    "bullmq": "^5.80.9",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
