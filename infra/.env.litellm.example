# SUNIL V2 - UPSTREAM PROVIDER CREDENTIALS (LiteLLM container only)
# =========================================================================
# Copy to `infra/.env.litellm` and fill in. That file is gitignored; this
# template is committed. Every value below is a DUMMY.
#
#   cp infra/.env.litellm.example infra/.env.litellm
#
# WHY THIS FILE IS SEPARATE FROM THE ROOT .env
# --------------------------------------------
# ADR-030 §2 states that provider keys live in the gateway so that "the
# application never holds an upstream credential". One shared root .env
# quietly broke that promise: the app process, dev-up, and every future
# container that read the root .env also saw ANTHROPIC_API_KEY. Flagged by
# the Phase 0 security and QA reviews.
#
# This file is attached to exactly ONE service, via `env_file:` on the
# `litellm` service in infra/docker-compose.yml. Compose passes it straight
# into that container's environment and interpolates nothing else from it,
# so the values are not visible to `docker compose config`, to the api stub,
# or to any other service.
#
# RULES
#   - Never add a variable here that the application needs. If the app needs
#     it, it belongs in the root .env.
#   - Never reference these names in the `environment:` block of the litellm
#     service: `environment:` OVERRIDES `env_file:`, so an interpolation from
#     the root .env would silently blank the value set here.
#   - Real values come from the secrets manager (docs/SECRETS_SETUP.md).
# =========================================================================


# --- Anthropic ------------------------------------------------------------
# Referenced by infra/litellm/config.yaml as `os.environ/ANTHROPIC_API_KEY`.
# Leaving the dummy in place is fine for platform work: the proxy boots and
# answers /health/liveliness regardless, and only fails on an actual
# completion call to a Claude model.
#
# Note (docs/ENVIRONMENT.md §8): the team's build machine has no ambient
# Anthropic API key - Claude access there is CLI-first on a subscription, not
# a raw API key. Expect this to stay dummy in local dev.
ANTHROPIC_API_KEY=sk-ant-dummy-not-a-real-key

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-dummy-not-a-real-key

# --- LiteLLM salt ---------------------------------------------------------
# Encrypts provider credentials that LiteLLM stores in its own database when
# models/keys are managed at runtime (STORE_MODEL_IN_DB=True). It protects
# the same class of secret as the two keys above, is used by no other
# process, and rotating it invalidates everything already encrypted with the
# old value - so it lives here rather than in the shared .env.
# Generate: openssl rand -hex 32
LITELLM_SALT_KEY=sk-dummy-litellm-salt-key-change-me

# --- OmniRoute - DEV LANE ONLY, PUBLIC WORKLOADS ONLY ---------------------
# Only needed if a human deliberately uncomments the OmniRoute entry in
# infra/litellm/config.yaml. ADR-030 §8: dev/experimentation lane, restricted
# to PUBLIC-classified workloads; never client or production data. Rejected
# for production (free-tier evasion, prompt-mutating compression, unclear
# privacy posture). Left commented so the lane is off by default.
# OMNIROUTE_API_BASE=http://host.docker.internal:20129/v1
# OMNIROUTE_API_KEY=dummy-omniroute-dev-key
