# SUNIL — Phase 1 (Foundation) environment template
#
# Copy this file to `.env` in the repo root (`cp .env.example .env` — see docs/LOCAL_SETUP.md)
# and fill in real values there. `.env` is git-ignored; this file is committed, so it must
# NEVER contain a real value — every variable below is name + explanation only, per
# PHASE1_ARCHITECTURE.md §16 and FR-092. Every variable is validated by a Zod env schema at
# process start (fail fast, names the offending variable, never prints the value — FR-004).
#
# This file is Phase 1's full §16 configuration inventory, plus a small "compose-only" section
# at the bottom for variables the official Postgres image and the Compose files need that are
# not part of §16 (they are consumed by containers, not by application code).

# =============================================================================================
# Database (Prisma / packages/db)
# =============================================================================================

# DATABASE_URL — full Postgres connection string Prisma and the api/worker containers use.
# Format:  postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
#   - Running inside Docker Compose: <host> is the service name "postgres", <port> is 5432
#     (the container's internal port — not whatever host port you may have published).
#   - Connecting from a host process (e.g. Prisma CLI run on the host against the dev override
#     — there is no host psql client, FR-093): <host> is "localhost", <port> is
#     SUNIL_PORT_POSTGRES below (only reachable if you brought the stack up with
#     docker-compose.dev.yml, which publishes it).
#   - <user>/<password>/<database> are POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below.
DATABASE_URL=

# =============================================================================================
# Redis (BullMQ / ioredis — rate-limit and lockout counters also live here)
# =============================================================================================

# REDIS_URL — connection string for ioredis/BullMQ.
# Format: redis://<host>:6379
#   - Inside Docker Compose: <host> is the service name "redis".
#   - From a host process via docker-compose.dev.yml: redis://localhost:<SUNIL_PORT_REDIS>.
# No Redis AUTH password is configured for Phase 1 local development (ADR-002 covers
# persistence, not auth; Redis is never published to a host port unless you opt in via
# docker-compose.dev.yml). Do not add an AUTH password here without updating docker-compose.yml
# and ADR-002 — that is an architecture change, not an env tweak.
REDIS_URL=

# =============================================================================================
# Secret envelope encryption (ADR-006) — the KEK/master key
# =============================================================================================

# SUNIL_MASTER_KEY — the KEK used to wrap every per-secret DEK (AES-256-GCM). MUST be base64
# of EXACTLY 32 bytes. The process refuses to start if this is absent or the wrong length
# (FR-004/FR-041) — this is deliberate, not a bug.
# Generate one (pick either — both produce base64 of 32 random bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
# Treat this like a database root password: losing it makes every stored secret permanently
# unrecoverable; leaking it exposes every stored secret. Never commit the real value anywhere,
# never paste it into chat/logs/tickets.
SUNIL_MASTER_KEY=

# SUNIL_MASTER_KEY_VERSION — integer identifying which key wrapped each secret's DEK. Not a
# secret itself. Start at 1 for a fresh install; increment only when rotating SUNIL_MASTER_KEY
# (in lockstep with moving the old key to SUNIL_MASTER_KEY_PREVIOUS below).
SUNIL_MASTER_KEY_VERSION=1

# SUNIL_MASTER_KEY_PREVIOUS — OPTIONAL. Set only during a KEK rotation window: the previous
# 32-byte base64 key, so secrets wrapped under it can still be decrypted (decrypt-with-old,
# re-wrap-with-current lazily on next read/rotate). Leave unset/empty on a fresh install.
SUNIL_MASTER_KEY_PREVIOUS=

# =============================================================================================
# Bootstrap — the sole owner account (FR-014; created once, idempotent re-run changes nothing)
# =============================================================================================

# SUNIL_OWNER_EMAIL — login email for the single seeded `owner` account. Not a secret, but
# personal to your install — leave unset in the committed template.
SUNIL_OWNER_EMAIL=

# SUNIL_OWNER_INITIAL_PASSWORD — the owner's initial password, read from the environment ONLY
# at bootstrap time. Never committed, never defaulted, never stored in plaintext after boot
# (it is immediately argon2id-hashed into User.passwordHash). Use a genuinely strong passphrase
# (16+ characters, e.g. a `node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"`
# generated value) — you should change it via the portal after first login, and you may then
# remove this variable from your local `.env` entirely.
SUNIL_OWNER_INITIAL_PASSWORD=

# =============================================================================================
# Session / cookie configuration (§6.1, §6.2; ADR-003)
# =============================================================================================

# SUNIL_COOKIE_SECURE — whether the session cookie gets the `Secure` attribute and the
# `__Host-` cookie-name prefix. Phase 1 is local-HTTP-only (assumption A-01), so the default
# below is `false` for local dev. The production configuration profile hard-fails startup if
# this is explicitly `false` (permissive-by-omission is impossible) — this variable is not
# meaningful outside Phase 1's local scope, but is documented here per §16.
SUNIL_COOKIE_SECURE=false

# SUNIL_SESSION_IDLE_HOURS — sliding idle-expiry window; a session with no activity for this
# long is rejected on the next request. Gate 1 default: 8 hours.
SUNIL_SESSION_IDLE_HOURS=8

# SUNIL_SESSION_ABSOLUTE_HOURS — hard ceiling on a session's lifetime from creation, never
# extended by activity. Gate 1 default: 24 hours.
SUNIL_SESSION_ABSOLUTE_HOURS=24

# =============================================================================================
# Brute-force protection (§6.3) — Gate 1 thresholds
# =============================================================================================

# SUNIL_AUTH_MAX_FAILURES — failed login attempts (per email, Redis-counted) before lockout.
# Gate 1 default: 5.
SUNIL_AUTH_MAX_FAILURES=5

# SUNIL_AUTH_FAILURE_WINDOW_MIN — rolling window (minutes) the failure counter above lives in
# before it resets (Redis key TTL). Gate 1 default: 15.
SUNIL_AUTH_FAILURE_WINDOW_MIN=15

# SUNIL_AUTH_LOCKOUT_MIN — how long (minutes) an account stays locked out once
# SUNIL_AUTH_MAX_FAILURES is reached. Gate 1 default: 15.
SUNIL_AUTH_LOCKOUT_MIN=15

# SUNIL_RATE_SESSION_PER_MIN — requests/minute allowed per authenticated session before a 429.
# Gate 1 default: 100.
SUNIL_RATE_SESSION_PER_MIN=100

# SUNIL_RATE_AUTH_IP_PER_MIN — requests/minute allowed per source IP on auth endpoints
# (login, mfa/verify) before a 429, checked before the lockout check. Gate 1 default: 20.
SUNIL_RATE_AUTH_IP_PER_MIN=20

# =============================================================================================
# Invitations (§5.2 Invitation model)
# =============================================================================================

# SUNIL_INVITE_TTL_HOURS — how long a single-use invitation link stays valid after creation.
# Gate 1 default: 72 hours. No mail transport exists in Phase 1 (assumption A-03) — the invite
# link is rendered in the API response for manual conveyance, not emailed.
SUNIL_INVITE_TTL_HOURS=72

# =============================================================================================
# Agent runtime (§11) — heartbeat / staleness detection
# =============================================================================================

# SUNIL_AGENT_HEARTBEAT_SEC — how often a running agent job emits an AGENT_HEARTBEAT envelope
# and updates Agent.lastHeartbeatAt. Default: 30 seconds.
SUNIL_AGENT_HEARTBEAT_SEC=30

# SUNIL_AGENT_STALE_SEC — how long since the last heartbeat before the out-of-process
# `system:agent-staleness-sweep` job marks a RUNNING agent STALE then FAILED. Default: 90
# seconds. Must be comfortably larger than SUNIL_AGENT_HEARTBEAT_SEC.
SUNIL_AGENT_STALE_SEC=90

# =============================================================================================
# Locale
# =============================================================================================

# SUNIL_TIMEZONE — default display/interpretation timezone (assumption A-10; the prototype's
# Australia/Melbourne clock was a known defect, not a decision).
SUNIL_TIMEZONE=Australia/Hobart

# =============================================================================================
# LLM providers (packages/llm — ADR-008). Phase 1 tests run entirely against mock transports
# (FR-003/A-11) — nothing in the automated test suite needs a real key. These are only for a
# developer who wants to manually exercise a real provider outside the test suite; leave blank
# otherwise. Even when set, these never appear in any API response, log, or portal bundle
# (§10.5 — providers stay "unverified against live endpoints" in Phase 1 regardless).
# =============================================================================================

# ANTHROPIC_API_KEY — format: starts with "sk-ant-". Get one at https://console.anthropic.com/
# if you want to manually smoke-test the Anthropic adapter. Not read by any test.
ANTHROPIC_API_KEY=

# OPENAI_API_KEY — format: starts with "sk-". Get one at https://platform.openai.com/ if you
# want to manually smoke-test the OpenAI adapter. Not read by any test.
OPENAI_API_KEY=

# OLLAMA_BASE_URL — base URL of an Ollama instance for the Ollama adapter. Not a secret.
#   - If you run Ollama via the optional `ollama` Compose profile (`docker compose --profile
#     ollama up -d`): http://ollama:11434 (reachable from other containers on the compose
#     network) — from the host, http://localhost:11434 (the ollama service publishes that port
#     by default).
#   - If you run Ollama natively on the Windows host instead: http://host.docker.internal:11434
#     (reachable from containers) or http://localhost:11434 (reachable from the host itself).
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================================
# Ports and URLs (§15.3 pitfall 4 — host-port conflicts are common; every published port is
# env-configurable with a documented default so a conflict is a one-line fix, not a rebuild)
# =============================================================================================

# SUNIL_PORT_WEB — host port the `web` container's port 3000 is published to. Default: 3000.
SUNIL_PORT_WEB=3000

# SUNIL_PORT_API — host port the `api` container's port 3001 is published to. This publish is
# for NON-BROWSER access only (QA exit-test suites, dev tooling, curl) — see ADR-011 below;
# the portal itself never talks to this port. Default: 3001.
SUNIL_PORT_API=3001

# SUNIL_API_INTERNAL_URL — SERVER-SIDE ONLY. Never sent to the browser, never compiled into
# the client bundle. ADR-011 (amendment A1): the browser only ever fetches relative `/api/...`
# paths from `apps/web` itself; `apps/web`'s Next `rewrites()` proxies those paths to this URL
# on the private network, and server components fetch it directly with the incoming session
# cookie forwarded. This is the *only* API-location config `apps/web` has.
#   - Default below (`http://localhost:3001`) is for host-run dev (`turbo dev`, apps/web
#     running directly on the host, per the §15.3 pitfall 6 dev loop).
#   - Under Docker Compose, `docker-compose.yml` sets this explicitly to `http://api:3001`
#     (the api service's name on the compose network) on the `web` service's `environment:` —
#     that explicit value wins over whatever is in your `.env` when running via Compose.
# `NEXT_PUBLIC_API_URL` is DELIBERATELY ABSENT (Amendment A1) — it has been removed from the
# configuration inventory. Same-origin relative paths mean no API URL belongs in the client
# bundle, and no CORS/allowed-origins variable exists anywhere by design. Do not reintroduce
# either — a cross-origin client requires a new ADR, not a config addition.
SUNIL_API_INTERNAL_URL=http://localhost:3001

# =============================================================================================
# Compose-only variables — NOT part of PHASE1_ARCHITECTURE.md §16. These configure the official
# `postgres`/pgvector container image directly (it is not application code, so it is outside
# the FR-092 "diff against every process.env read in the codebase" check) and the optional
# docker-compose.dev.yml host-port publishing for postgres/redis. Listed here anyway for
# completeness and because DATABASE_URL/REDIS_URL above are built from them.
#
# docker-compose.yml already has safe, non-sensitive local-dev fallback defaults for the three
# POSTGRES_* variables (see that file's comments), so `docker compose up -d postgres redis`
# works even before you create a `.env` at all. Set them here once you want the containers to
# use YOUR values, or once you're doing anything beyond solo local dev on this one machine.
# =============================================================================================

# POSTGRES_USER — Postgres superuser created on first init. Compose fallback default: "sunil".
POSTGRES_USER=

# POSTGRES_PASSWORD — password for POSTGRES_USER. Compose fallback default is a well-known
# local-only placeholder ("sunil_local_dev_only") — postgres is never published to a host port
# by the base docker-compose.yml, so that placeholder is only reachable from other containers
# on this machine's compose network. Set a real value here regardless if this machine is
# shared, or once you use docker-compose.dev.yml (which does publish a host port).
POSTGRES_PASSWORD=

# POSTGRES_DB — database created on first init. Compose fallback default: "sunil".
POSTGRES_DB=

# SUNIL_PORT_POSTGRES — OPTIONAL. Only used by docker-compose.dev.yml, which publishes
# postgres's 5432 to this host port for local GUI tools / host-run Prisma (there is no host
# psql client — every documented DB operation otherwise goes through
# `docker compose exec postgres psql ...` or Prisma, FR-093). Default: 5432.
SUNIL_PORT_POSTGRES=5432

# SUNIL_PORT_REDIS — OPTIONAL. Only used by docker-compose.dev.yml, which publishes redis's
# 6379 to this host port for local inspection tools. Default: 6379.
SUNIL_PORT_REDIS=6379
