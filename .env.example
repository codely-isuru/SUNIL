# SUNIL V2 — development environment template
# =========================================================================
# Copy to `.env` in the REPO ROOT and fill in. `.env` is gitignored; this
# template is committed.
#
#   cp .env.example .env
#
# Every value below is a DUMMY. Nothing here is a real credential, and no
# real credential may ever be committed — provider keys and any shared secret
# come from the secrets manager (docs/SECRETS_SETUP.md), not from this file.
#
# The stack is always invoked with this file passed explicitly, because
# Compose would otherwise look for `infra/.env` next to the compose file:
#
#   docker compose --env-file .env -f infra/docker-compose.yml up -d
#
# scripts/dev-up.ps1 and scripts/dev-up.sh do that for you.
# =========================================================================


# --- Compose project ------------------------------------------------------
# Prefixes container, volume and network names. Change it and you get a
# second, fully isolated stack (with empty volumes).
COMPOSE_PROJECT_NAME=sunil-v2


# --- Postgres 17 + pgvector -----------------------------------------------
# The single stateful service. Holds three logical databases: the SUNIL
# application DB, plus one each for LiteLLM and n8n internal state (created
# on first boot by infra/postgres/init/01-init-databases.sh).
POSTGRES_USER=sunil
# REQUIRED. No default in Compose on purpose — an unset value makes Postgres
# refuse to start rather than come up guessable. Generate a fresh one:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
#   bash:       openssl rand -hex 24
POSTGRES_PASSWORD=dummy-change-me-local-only
POSTGRES_DB=sunil
LITELLM_DB_NAME=litellm
N8N_DB_NAME=n8n
# Host-side port. 5433, NOT 5432: on the current build machine 5432 is
# already bound by an unrelated container (strapi-next-starter-db-1).
# Container-internal port stays 5432.
POSTGRES_HOST_PORT=5433


# --- LiteLLM (model gateway, ADR-030 §2) ----------------------------------
# Host-side port. 4000 is LiteLLM's own default and is free here.
# NEVER use 4317 — that port belongs to the Minions Portal.
LITELLM_HOST_PORT=4000
# REQUIRED. Admin/root credential for the proxy and its UI. Must start with
# `sk-`. This is what the application will present as its own API key until
# per-agent virtual keys land in Stream B.
LITELLM_MASTER_KEY=sk-dummy-litellm-master-key-change-me
# REQUIRED. Encrypts provider credentials stored in the DB. Rotating this
# invalidates everything already encrypted with the old value — set it once
# and leave it alone.
LITELLM_SALT_KEY=sk-dummy-litellm-salt-key-change-me
# Manage models/keys at runtime through the proxy DB rather than only via
# config.yaml. Needed for per-agent budgets.
LITELLM_STORE_MODEL_IN_DB=True


# --- Upstream model providers ---------------------------------------------
# Consumed ONLY by the LiteLLM container, via `os.environ/...` in
# infra/litellm/config.yaml. The application must never receive these.
#
# Leaving them at the dummy values is fine for platform work: the proxy boots
# and answers its health endpoint regardless, and only fails on an actual
# completion call. Real values come from the secrets manager.
#
# Note (docs/ENVIRONMENT.md §8): this machine has no ambient ANTHROPIC_API_KEY
# — Claude access here is CLI-first on a subscription, not a raw API key.
ANTHROPIC_API_KEY=sk-ant-dummy-not-a-real-key
OPENAI_API_KEY=sk-dummy-not-a-real-key

# --- OmniRoute — DEV LANE ONLY, PUBLIC WORKLOADS ONLY ---------------------
# Only needed if a human deliberately uncomments the OmniRoute entry in
# infra/litellm/config.yaml. ADR-030 §8: dev/experimentation lane, restricted
# to PUBLIC-classified workloads; never client or production data. Rejected
# for production (free-tier evasion, prompt-mutating compression, unclear
# privacy posture). Left commented so the lane is off by default.
# OMNIROUTE_API_BASE=http://host.docker.internal:20129/v1
# OMNIROUTE_API_KEY=dummy-omniroute-dev-key


# --- n8n (workflows + connector fabric, ADR-030 §5) -----------------------
# Host-side port. 5680, NOT the 5678 default and NOT 5679: on the current
# build machine a host-native n8n source build (C:\repo\n8n) holds BOTH 5678
# and 5679 from a single node process. Container-internal port stays 5678.
N8N_HOST_PORT=5680
N8N_HOST=localhost
N8N_PROTOCOL=http
# Must carry the HOST port, or webhook URLs shown in the n8n editor are not
# reachable from a browser. Keep in sync with N8N_HOST_PORT.
N8N_WEBHOOK_URL=http://localhost:5680/
# REQUIRED. Encrypts n8n's own credential vault at rest — and per ADR-030 §5
# third-party credentials live in that vault and nowhere else, so this key
# protects real secrets. Losing or changing it makes every stored credential
# undecryptable. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=dummy-n8n-encryption-key-change-me
# Opt out of upstream telemetry.
N8N_DIAGNOSTICS_ENABLED=false
# Keep host environment variables out of reach of Code nodes.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true


# --- Shared ---------------------------------------------------------------
# Drives n8n schedule evaluation (cron in this zone) and container log times.
GENERIC_TIMEZONE=Australia/Melbourne


# --- Application container (NOT YET ACTIVE) -------------------------------
# The api service is a commented stub in infra/docker-compose.yml: branch V2
# is a clean-slate rebuild and no application code exists yet (ADR-030
# Amendment 1). These are listed now so the port choice is reserved and
# reviewed; uncomment when the rebuilt gateway lands.
# API_HOST_PORT=8000
# WEB_HOST_PORT=3001        # 3000 is already occupied on the build machine
