# SUNIL environment inventory — placeholders only.
# See docs/ARCHITECTURE_V1.md §14.4 for what reads each variable.
#
# Copy this file to `.env` at the repo root, then fill in the values marked
# secret below. NEVER commit a real value here — a real credential in this
# file is an ET-10 failure (docs/M1_BUILD_PLAN.md §2 T1 "Watch").

# -- Database ----------------------------------------------------------------
# db/session. SQLite for local dev/M1; switch to a postgresql+psycopg URL to
# use Postgres (docker compose). May carry embedded credentials on Postgres.
DATABASE_URL=sqlite+aiosqlite:///./var/sunil.db

# -- Provider / integration secrets ------------------------------------------
# providers/anthropic — secret
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# tools/github — secret. Fine-grained PAT scoped to
# codely-isuru/easy_clean_workforce with Contents:read + Pull requests:read +
# Issues:read and nothing else.
GITHUB_TOKEN=github_pat_REPLACE_ME

# -- Session ------------------------------------------------------------------
# SessionMiddleware — secret. 32+ random bytes.
SESSION_SECRET=REPLACE_ME_32_BYTES
SESSION_COOKIE_NAME=sunil_session

# -- CORS / origin --------------------------------------------------------------
# CORS + origin check. Must be `localhost`, never `127.0.0.1` (ADR-008) — a
# mismatch silently withholds the session cookie.
WEB_ORIGIN=http://localhost:3000

# -- uvicorn ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# -- logging ------------------------------------------------------------------------
LOG_LEVEL=INFO

# -- Feature flags / turn control (owner's review additions) --------------------------
# SSE progress channel (T12, optional/post-M1). Ships false.
SUNIL_PROGRESS_EVENTS=false
# Registry loaders (config/*.yaml) read from this directory (ADR-016).
SUNIL_CONFIG_DIR=./config
# Server-side per-turn deadline in seconds (§5.3). Below the 45s client timeout.
SUNIL_TURN_DEADLINE_S=40

# -- Owner account (scripts/seed-owner.py only) -----------------------------------------
# secret (OWNER_PASSWORD)
OWNER_USERNAME=isuru
OWNER_PASSWORD=REPLACE_ME

# -- Frontend (apps/web) -----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
