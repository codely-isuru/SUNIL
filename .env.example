# SUNIL V2 — development environment template
# =========================================================================
# Copy to `.env` in the REPO ROOT and fill in. `.env` is gitignored; this
# template is committed.
#
#   cp .env.example .env
#
# Every value below is a DUMMY. Nothing here is a real credential, and no
# real credential may ever be committed — provider keys and any shared secret
# come from the secrets manager (docs/SECRETS_SETUP.md), not from this file.
#
# DUMMY VALUES DO NOT BOOT. `scripts/dev-up.*` rejects any secret whose value
# still matches `dummy` or `change-me`, and when it creates `.env` for you it
# generates real random values for the ones it can. That is deliberate: the
# repository is PUBLIC, so a stack running on the passwords in this file is
# a stack running on a published password.
#
# Upstream PROVIDER keys are NOT here — see infra/.env.litellm.example. They
# are scoped to the LiteLLM container so the application process never sees
# an upstream credential (ADR-030 §2).
#
# The stack is always invoked with this file passed explicitly, because
# Compose would otherwise look for `infra/.env` next to the compose file:
#
#   docker compose --env-file .env -f infra/docker-compose.yml up -d
#
# scripts/dev-up.ps1 and scripts/dev-up.sh do that for you.
# =========================================================================


# --- Compose project ------------------------------------------------------
# Prefixes container, volume and network names. Change it and you get a
# second, fully isolated stack (with empty volumes).
COMPOSE_PROJECT_NAME=sunil-v2


# --- Postgres 17 + pgvector -----------------------------------------------
# The single stateful service. Holds three logical databases, each with its
# OWN login role, created on first boot by
# infra/postgres/init/01-init-databases.sh:
#
#   sunil    owner sunil        application data: approvals, audit_events, ...
#   litellm  owner litellm_user gateway virtual keys, budgets, spend
#   n8n      owner n8n_user     workflow state and n8n's credential vault
#
# litellm_user and n8n_user have CONNECT on `sunil` REVOKED (TB9): a
# compromised gateway or workflow container cannot reach the audit spine.
POSTGRES_USER=sunil
# REQUIRED. Compose declares this as ${POSTGRES_PASSWORD:?...}, so an unset
# or empty value refuses to resolve at all — the stack will not start on a
# blank password. Easiest: let scripts/dev-up.ps1 / dev-up.sh create .env —
# they generate this from the OS CSPRNG. Generating by hand:
#   PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(24))
#   bash:       openssl rand -hex 24
# Never Get-Random: it is a seeded PRNG, not a cryptographic one, and this
# password guards the audit spine.
POSTGRES_PASSWORD=dummy-change-me-local-only
POSTGRES_DB=sunil
LITELLM_DB_NAME=litellm
N8N_DB_NAME=n8n
# REQUIRED. Passwords for the two least-privilege roles above. Keep them
# ALPHANUMERIC: both are embedded in a connection URL, and `@`, `:`, `/` or
# `#` in a password silently truncates or misparses that URL. `openssl rand
# -hex 24` is exactly right.
# Changing either of these after first boot does NOT re-run the init script —
# it only breaks the matching service. To change one: ALTER ROLE in psql, or
# `docker compose down -v` and lose the data.
LITELLM_DB_PASSWORD=dummy-change-me-litellm-db
N8N_DB_PASSWORD=dummy-change-me-n8n-db
# Host-side port. 5433, NOT 5432: on the current build machine 5432 is
# already bound by an unrelated container (strapi-next-starter-db-1).
# Container-internal port stays 5432. Published on 127.0.0.1 only.
POSTGRES_HOST_PORT=5433


# --- LiteLLM (model gateway, ADR-030 §2) ----------------------------------
# Host-side port. 4000 is LiteLLM's own default and is free here.
# NEVER use 4317 — that port belongs to the Minions Portal.
LITELLM_HOST_PORT=4000
# REQUIRED. ADMIN credential for the proxy and its UI: it can mint virtual
# keys and read every agent's spend. Must start with `sk-`.
# The application must NOT use this key — it uses a virtual key
# (LITELLM_VIRTUAL_KEY_DEFAULT below), minted against this one.
LITELLM_MASTER_KEY=sk-dummy-litellm-master-key-change-me
# Manage models/keys at runtime through the proxy DB rather than only via
# config.yaml. Needed for per-agent budgets.
LITELLM_STORE_MODEL_IN_DB=True
#
# LITELLM_SALT_KEY, ANTHROPIC_API_KEY and OPENAI_API_KEY are deliberately
# NOT in this file: see infra/.env.litellm.example.


# --- n8n (workflows + connector fabric, ADR-030 §5) -----------------------
# Host-side port. 5680, NOT the 5678 default and NOT 5679: on the current
# build machine a host-native n8n source build (C:\repo\n8n) holds BOTH 5678
# and 5679 from a single node process. Container-internal port stays 5678.
# Published on 127.0.0.1 only — n8n 2.x shows an unauthenticated owner-setup
# screen on first boot, and whoever reaches it first owns the vault.
N8N_HOST_PORT=5680
N8N_HOST=localhost
N8N_PROTOCOL=http
# Must carry the HOST port, or webhook URLs shown in the n8n editor are not
# reachable from a browser. Keep in sync with N8N_HOST_PORT.
N8N_WEBHOOK_URL=http://localhost:5680/
# REQUIRED. Encrypts n8n's own credential vault at rest — and per ADR-030 §5
# third-party credentials live in that vault and nowhere else, so this key
# protects real secrets. Losing or changing it makes every stored credential
# undecryptable. Left EMPTY, n8n generates its own and the vault becomes
# unmanaged, which is why Compose declares it ${N8N_ENCRYPTION_KEY:?...}.
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=dummy-n8n-encryption-key-change-me
# Opt out of upstream telemetry.
N8N_DIAGNOSTICS_ENABLED=false
# Keep host environment variables out of reach of Code nodes.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true


# --- Shared ---------------------------------------------------------------
# Drives n8n schedule evaluation (cron in this zone) and container log times.
GENERIC_TIMEZONE=Australia/Melbourne


# =========================================================================
# APPLICATION VARIABLES (ARCHITECTURE_V2 §5 inventory)
# =========================================================================
# The `api` service in infra/docker-compose.yml is still a commented stub —
# branch V2 is a clean-slate rebuild and no application code exists yet
# (ADR-030 Amendment 1). The variables are listed here NOW, live rather than
# commented, because six parallel streams need the names and the values to
# agree before they write code against them: the QA cross-branch sweep found
# the first draft of the stub inventing names (`LLM_BASE_URL`) that appear in
# no contract.
#
# HOST vs IN-NETWORK — the one thing to get right here:
#   * These values are for a process running ON THE HOST (`uvicorn` in a
#     terminal, a pytest run, the Next.js dev server). They use localhost and
#     the PUBLISHED ports: 5433, 4000, 5680.
#   * A process running INSIDE the Compose network uses the service name and
#     the container-internal port instead: postgres:5432, litellm:4000,
#     n8n:5678. The commented api stub shows those.
# Both are correct; mixing them is the failure this note exists to prevent.
# =========================================================================

# --- Database -------------------------------------------------------------
# Application connection string. Keep the password in sync with
# POSTGRES_PASSWORD above; keep the port in sync with POSTGRES_HOST_PORT.
# Driver token is `+psycopg` (psycopg v3), NOT `+asyncpg`: ADR-002's recorded
# driver, and one dependency serves both SQLAlchemy 2's async engine and
# Alembic's sync migration path (ARCHITECTURE_V2 §5 ruling, S-1).
DATABASE_URL=postgresql+psycopg://sunil:dummy-change-me-local-only@localhost:5433/sunil

# --- HTTP / session -------------------------------------------------------
# REQUIRED. Signs the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=dummy-session-secret-change-me
SESSION_COOKIE_NAME=sunil_session
# The ONLY browser origin the API accepts (ADR-035 / C5): anything else gets
# 403 forbidden_client. 3001, not 3000 — port 3000 is occupied on the build
# machine, so the web dev server runs on 3001 and this value must match it
# exactly (scheme, host, port; no trailing slash).
WEB_ORIGIN=http://localhost:3001
# Where the API binds when run on the host. 127.0.0.1, never 0.0.0.0: the
# same loopback rule that applies to the containers (ADR-032).
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# --- Runtime config -------------------------------------------------------
# Directory holding the declarative agent/tool/model config (ADR-016/034).
SUNIL_CONFIG_DIR=./config
# Wall-clock budget for one turn, seconds. Exceeding it fails the turn
# closed rather than hanging the request. 40 = M1's live-verified ~6 s turn
# against a 30 s p95 target plus headroom (ARCHITECTURE_V2 §5 ruling, S-3);
# a fail-closed deadline must be tight enough that a hang surfaces in dev.
# Raise it in your local .env for step-debugging, never in this template.
SUNIL_TURN_DEADLINE_S=40

# --- LLM access (never a provider key) ------------------------------------
# Which lane C2 sends completions down. `gateway` = through LiteLLM, which is
# the only egress to model providers (ADR-030 §2). Changing this lane does
# not change routing policy, only the destination (ADR-017).
SUNIL_LLM_PROVIDER_LANE=gateway
# HOST address of the gateway. In-network it is http://litellm:4000.
SUNIL_LLM_GATEWAY_BASE_URL=http://localhost:4000
# REQUIRED. The app's own VIRTUAL key, minted against LITELLM_MASTER_KEY via
# POST /key/generate, with its own budget. Deliberately not the master key:
# the app should not be able to mint keys or read other agents' spend.
LITELLM_VIRTUAL_KEY_DEFAULT=sk-dummy-virtual-key-change-me

# --- n8n integration (Stream E) -------------------------------------------
# HOST address of n8n's MCP endpoint. In-network it is
# http://n8n:5678/mcp/sunil.
# The port here is 5680 for the same reason as N8N_HOST_PORT: 5678/5679 are
# taken on this machine by an unrelated host-native n8n.
# The `/sunil` suffix is the MCP Server Trigger workflow's OWN path and is not
# optional: `/mcp` is n8n's prefix and answers 404, and n8n gives a webhook no
# way to be served at the bare prefix (verified against the live 2.38.5 server —
# docs/tasks/S2-E-n8n.md §3).
SUNIL_N8N_MCP_BASE_URL=http://localhost:5680/mcp/sunil
# REQUIRED. Bearer token the MCP endpoint enforces. Enforcement is now PROVEN
# against n8n 2.38.5 (docs/tasks/S2-E-n8n.md §4): no header, a wrong token, the
# token as HTTP Basic and the token in a query string are all 403 — on every
# request, including `tools/list` — and a valid MCP session id does not
# substitute for it. That proof is bound to the shipped workflow export, which
# sets `authentication: bearerAuth`; the node's own DEFAULT is `none`, which
# serves every MCP method unauthenticated, so the loopback-only publish above
# stays load-bearing.
SUNIL_N8N_MCP_AUTH_TOKEN=dummy-n8n-mcp-token-change-me

# --- Developer execution engine (Stream F, ADR-033 Amendment 1) ------------
# HOST address of the OpenHands engine. In-network it is http://openhands:3000.
# Port 3400 is ADR-032's frozen pair (127.0.0.1:3400 -> 3000).
# NOTHING READS THIS YET and the service is still commented out in
# infra/docker-compose.yml: enabling the engine needs the sandbox
# runtime-isolation decision (an ADR, not an edit — docs/tasks/S2-F-openhands.md
# §4), because its default runtime wants the host docker socket.
# The value is bound by ADR-033's named-host rule: loopback or the literal
# Compose host `openhands`, nothing else. Pointing it at a hosted runtime is a
# privacy-class decision — it ships repository contents off-machine — and the
# validator refuses it rather than leaving that to a code review.
SUNIL_OPENHANDS_BASE_URL=http://localhost:3400

# --- Approvals (C4) -------------------------------------------------------
# How long a pending approval stays actionable before the sweeper expires it.
SUNIL_APPROVAL_TTL_HOURS=72
# How long an APPROVED approval stays consumable after the owner's decision:
# the consume CAS refuses anything older and the sweeper expires it (C4 §1
# grace-bounded consume — Security review 2026-09-10 item 1). A decided-but-
# never-consumed approval must not stay silently spendable across downtime.
SUNIL_APPROVAL_CONSUME_GRACE_HOURS=1
# Optional. Where a "waiting for your approval" notification is POSTed.
# Empty = no notification is sent (the approval still parks correctly).
# Treat the URL itself as sensitive: it is a capability.
SUNIL_APPROVAL_NOTIFY_WEBHOOK_URL=
# Run C4 §1's sweep (once at startup, then every 60 s) IN THIS PROCESS.
# Defaults ON, and leaving it on is the safe posture. Turning it off does not
# merely delay expiry: lazy expiry at read/decide time only reaches rows that
# somebody reads, so an APPROVED approval past its grace window that nobody
# touches again stays spendable — the hole the 2026-09-10 security review
# closed. Turn it off only when another process owns the schedule, or to
# quarantine the sweep during an incident. The startup half also runs C4 §3's
# reconciliation, so with it off, interrupted continuations are not reconciled
# on boot either.
SUNIL_APPROVALS_SWEEPER_ENABLED=true

# --- Seam selection (ARCHITECTURE_V2 §3's plug order) ----------------------
# Each names WHICH implementation of a frozen contract is wired at boot.
# `real` is the committed value for both; `fake` selects an implementation the
# caller must INJECT (sunil.api.wiring.Seams) and is therefore only reachable
# from a test — production code never imports a test double, and an uninjected
# `fake` is a boot failure rather than a silent fallback. Set either to `fake`
# in a deployed .env and the application refuses to start; that refusal is the
# feature. (SUNIL_MEMORY_PROVIDER, below, is the same seam for C3.)
SUNIL_TOOL_MANAGER=real
SUNIL_APPROVALS_SERVICE=real

# --- Service lane (ADR-035) -----------------------------------------------
# REQUIRED. Bearer token for the service lane, which may reach exactly one
# route: POST /api/v1/chat. Compared in constant time; rotate by changing
# this value. Generate: openssl rand -hex 32
# Dev default (ARCHITECTURE_V2 §5): scripts/dev-up.* generates this on .env
# auto-create, so the n8n→API lane (TB7) is ON in a generated dev env. When
# the variable is genuinely UNSET the application boots with the machine lane
# OFF — fail closed, the production-safe default.
SUNIL_SERVICE_TOKEN=dummy-service-token-change-me

# --- Memory (Stream C) ----------------------------------------------------
# Backing implementation for the C3 memory port.
#   pgvector  the BUILT one (memory_providers/pgvector_provider.py) — the
#             `memories` + entity tables in the `sunil` database above, using
#             the `vector` extension. Needs migration 0005.
#   mem0      still UNBUILT and still selectable: it refuses to boot rather
#             than falling back to pgvector, because an operator who asked for
#             Mem0 must not silently get different retrieval. Keeping the name
#             live is what keeps ADR-030's "vendor behind the seam" an option.
#   fake      requires an injected seam — reachable only from a test.
# `fake` is the application default when this variable is absent.
SUNIL_MEMORY_PROVIDER=pgvector

# How memory embeddings are produced.
#   hashing   deterministic, local, NO credential. Retrieval is lexical (a bag
#             of words hashed into 1536 buckets, cosine-ranked) rather than
#             semantic — no synonyms, no paraphrase. The default, because a
#             deployment with no embedding key should still remember.
#   gateway   the real model, through LiteLLM's OpenAI-compatible
#             /v1/embeddings, so routing and per-key budgets apply. REFUSES to
#             boot without SUNIL_MEMORY_EMBEDDING_API_KEY — a deployment that
#             asked for semantic recall must not quietly get lexical recall.
# NOTE the embedding width is SCHEMA (`memories.embedding` is vector(1536)):
# changing embedding family is a migration, not a config flip.
SUNIL_MEMORY_EMBEDDER=hashing
SUNIL_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# The LiteLLM virtual key used for embedding calls. Empty with
# SUNIL_MEMORY_EMBEDDER=gateway is a boot failure, on purpose.
SUNIL_MEMORY_EMBEDDING_API_KEY=

# --- Tool credentials -----------------------------------------------------
# Optional. Read-scope token for the GitHub tools. Empty = those tools are
# unavailable, which is the correct default: a tool with no credential must
# fail closed, not fall back to an ambient one.
# Long term these belong in n8n's encrypted vault (ADR-030 §5), not here.
GITHUB_TOKEN=

# --- Web (Next.js, Stream F) ----------------------------------------------
# Baked into the browser bundle at build time — NEXT_PUBLIC_* is world
# readable by design, so never put a secret behind that prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Host ports for the app containers (stub, not yet active) -------------
# API_HOST_PORT=8000
# WEB_HOST_PORT=3001        # 3000 is already occupied on the build machine
